namespace openmls_uniffi {
    void init_logger();

    [Throws=MlsError]
    ExternalJoinResult join_external(Provider provider, Identity identity, bytes group_info, RatchetTree? ratchet_tree);
    [Throws=MlsError]
    ExternalJoinResult join_external_with_policy(Provider provider, Identity identity, bytes group_info, RatchetTree? ratchet_tree, boolean allow_expired_tree_leaves);

    [Throws=MlsError]
    ArchivedMessage decrypt_epoch_archive_v2(Provider provider, bytes archive, bytes snapshot, bytes ciphertext, boolean allow_own_messages, u32 max_forward_distance);

    [Throws=MlsError]
    RecoveryKeys generate_recovery_keys();
    [Throws=MlsError]
    bytes create_recovery_vault(string pin, RecoveryKeys keys);
    [Throws=MlsError]
    RecoveryVaultMetadata recovery_vault_metadata(bytes vault);
    [Throws=MlsError]
    bytes unlock_recovery_vault(string pin, bytes vault);
    [Throws=MlsError]
    RecoveryArchiveBlob seal_recovery_archive(bytes archive, string cid, u64 group_generation, u64 epoch, string scope, string blob_id, string snapshot_hash);
    [Throws=MlsError]
    RecoveryArchiveWrap wrap_recovery_archive_key(bytes adk, bytes public_key, string cid, u64 group_generation, u64 epoch, string scope, string blob_id, string snapshot_hash, string key_id);
    [Throws=MlsError]
    bytes open_recovery_archive(bytes private_key, RecoveryArchiveBlob blob, RecoveryArchiveWrap wrap);

    boolean validate_key_package_bytes(bytes data);
};

[Error]
enum MlsError {
    "SerializationError",
    "DeserializationError",
    "GroupNotOperational",
    "MemberNotFound",
    "InvalidMessage",
    "MessageAlreadyConsumed",
    "NoWelcome",
    "InvalidCid",
    "InvalidGroupId",
    "StorageError",
    "GroupNotFound",
    "CryptoError",
    "InvalidState",
    "ExternalCommitError",
    "InternalError",
    "NoMatchingKeyPackage",
    "LifetimeRangeInvalid",
    "LeafNotYetValid",
    "KeyPackageExpired",
    "InvalidClock",
    "StorageCorruption",
    "GroupInfoInvalid",
    "EpochConflict",
    "TransportUnknown",
    "AcceptanceMetadataInvalid",
};

enum MessageType {
    "ApplicationMessage",
    "Proposal",
    "Commit",
};

dictionary MemberInfo {
    u32 index;
    string user_id;
    bytes encryption_key;
    bytes signature_key;
};

dictionary CommitBundle {
    bytes commit;
    bytes? welcome;
    bytes? group_info;
};

dictionary ProposalMessage {
    bytes bytes;
    bytes proposal_ref;
};

dictionary ProcessedMessage {
    MessageType message_type;
    bytes? content;
    u32 sender_index;
    u64 epoch;
    bytes aad;
};

dictionary ExportedEpochArchiveV2 {
    bytes archive_bytes;
    bytes snapshot_bytes;
    bytes snapshot_hash;
};

dictionary ArchivedMessage {
    bytes content;
    u32 sender_index;
    u32 generation;
    u64 epoch;
    bytes aad;
    boolean own_message;
};

dictionary ExternalJoinResult {
    Group group;
    bytes commit;
};

interface Provider {
    constructor();

    [Throws=MlsError, Name=new_with_path]
    constructor(string db_path);

    // Group queries & management
    [Throws=MlsError]
    sequence<string> stored_group_ids();

    [Throws=MlsError]
    u32 group_count();

    [Throws=MlsError]
    void delete_group(string cid);

    [Throws=MlsError]
    void delete_all_groups();

    // Identity persistence
    [Throws=MlsError]
    void store_identity(string user_id, bytes identity_bytes);

    [Throws=MlsError]
    bytes? load_identity();

    [Throws=MlsError]
    void delete_identity();

    [Throws=MlsError]
    string key_package_upload_provider_id();
};

interface Identity {
    [Throws=MlsError]
    constructor(Provider provider, string user_id);

    string user_id();
    bytes signature_public_key();
    [Throws=MlsError]
    bytes device_registration_signature(string device_id, string project_id, i64 issued_at);
    [Throws=MlsError]
    bytes lor_request_signature(string context_json);
    [Throws=MlsError]
    boolean owns_key_package_ref(Provider provider, bytes reference);
    [Throws=MlsError]
    KeyPackage key_package(Provider provider);
    [Throws=MlsError]
    sequence<KeyPackage> key_packages(Provider provider, u32 count);

    [Throws=MlsError]
    bytes to_bytes();

    [Throws=MlsError, Name=from_bytes]
    constructor(Provider provider, bytes data);

    [Throws=MlsError]
    sequence<bytes> prepare_key_package_upload(Provider provider, string operation_id, string scope, string expected_provider_id, u32 count);

    [Throws=MlsError]
    sequence<bytes>? recover_key_package_upload(Provider provider, string operation_id, string scope);
};

interface KeyPackage {
    [Throws=MlsError]
    bytes to_bytes();

    [Throws=MlsError, Name=from_bytes]
    constructor(bytes data);

    [Throws=MlsError]
    bytes hash_ref(Provider provider);
};

interface RatchetTree {
    bytes to_bytes();

    [Throws=MlsError, Name=from_bytes]
    constructor(bytes data);
};

interface Group {
    [Throws=MlsError, Name=create_with_cid]
    constructor(Provider provider, Identity founder, string cid);

    [Throws=MlsError, Name=create_with_group_id]
    constructor(Provider provider, Identity founder, bytes group_id);

    [Throws=MlsError, Name=join_with_welcome_with_policy]
    constructor(Provider provider, bytes welcome, RatchetTree? ratchet_tree, boolean allow_expired_tree_leaves);

    [Throws=MlsError, Name=join_with_welcome]
    constructor(Provider provider, bytes welcome, RatchetTree? ratchet_tree);

    [Throws=MlsError, Name=load_from_storage]
    constructor(Provider provider, string cid);

    [Throws=MlsError, Name=load_from_storage_with_group_id]
    constructor(Provider provider, bytes group_id);

    // State
    [Throws=MlsError]
    void save_state(Provider provider);

    [Throws=MlsError]
    void delete_state(Provider provider);

    [Throws=MlsError]
    string cid();
    bytes group_id();
    [Throws=MlsError]
    bytes public_context_fingerprint();
    [Throws=MlsError]
    bytes staged_external_commit_public_context_fingerprint(Provider provider, bytes commit);
    [Throws=MlsError]
    bytes evicted_external_commit_public_context_fingerprint(Provider provider, bytes commit, bytes ratchet_tree, u64 before_epoch);
    [Throws=MlsError]
    ProcessedMessage process_evicted_epoch_application_deferred(Provider provider, bytes msg, bytes ratchet_tree, u64 before_epoch);
    u64 epoch();
    sequence<MemberInfo> members();
    MemberInfo? member_by_user_id(string user_id);
    sequence<MemberInfo> members_by_user_id(string user_id);
    u32 own_leaf_index();
    boolean is_operational();
    boolean has_pending_commit();
    RatchetTree export_ratchet_tree();

    [Throws=MlsError]
    ExportedEpochArchiveV2 archive_epoch_v2();

    [Throws=MlsError]
    bytes export_group_info(Provider provider, Identity sender, boolean with_ratchet_tree);

    [Throws=MlsError]
    bytes export_key(Provider provider, string label, bytes context, u32 key_length);

    // Messaging
    [Throws=MlsError]
    bytes create_message(Provider provider, Identity sender, bytes plaintext);

    void set_aad(bytes aad);

    [Throws=MlsError]
    bytes create_message_with_aad(Provider provider, Identity sender, bytes plaintext, bytes aad);

    [Throws=MlsError]
    ProcessedMessage process_message(Provider provider, bytes msg);

    [Throws=MlsError]
    ProcessedMessage process_message_at(Provider provider, bytes msg, u64 server_accepted_at_seconds);

    [Throws=MlsError]
    ProcessedMessage process_message_deferred(Provider provider, bytes msg);

    [Throws=MlsError]
    ProcessedMessage process_message_with_context(Provider provider, bytes msg, string context_json, string event_id, string cid, u64 group_generation, u64 event_epoch, boolean defer_secret_persistence);

    [Throws=MlsError]
    bytes process_message_raw(Provider provider, bytes msg);

    // Proposals
    [Throws=MlsError]
    ProposalMessage propose_add_member(Provider provider, Identity sender, KeyPackage new_member);

    [Throws=MlsError]
    sequence<ProposalMessage> propose_add_user(Provider provider, Identity sender, sequence<KeyPackage> device_key_packages);

    [Throws=MlsError]
    ProposalMessage propose_remove_member(Provider provider, Identity sender, u32 member_index);

    [Throws=MlsError]
    ProposalMessage propose_remove_member_by_user_id(Provider provider, Identity sender, string user_id);

    [Throws=MlsError]
    ProposalMessage propose_self_update(Provider provider, Identity sender);

    [Throws=MlsError]
    bytes leave_group(Provider provider, Identity sender);

    u64 pending_proposals_count();

    [Throws=MlsError]
    void clear_pending_proposals(Provider provider);

    // Commits
    [Throws=MlsError]
    CommitBundle commit_pending_proposals(Provider provider, Identity sender);

    [Throws=MlsError]
    void merge_pending_commit(Provider provider);

    [Throws=MlsError]
    void clear_pending_commit(Provider provider);

    [Throws=MlsError]
    CommitBundle add_members(Provider provider, Identity sender, sequence<KeyPackage> new_members);

    [Throws=MlsError]
    CommitBundle add_user(Provider provider, Identity sender, sequence<KeyPackage> device_key_packages);

    [Throws=MlsError]
    CommitBundle remove_members(Provider provider, Identity sender, sequence<u32> member_indices);

    [Throws=MlsError]
    CommitBundle remove_user(Provider provider, Identity sender, string user_id);

    [Throws=MlsError]
    CommitBundle remove_users(Provider provider, Identity sender, sequence<string> user_ids);

    [Throws=MlsError]
    CommitBundle commit_group_changes(
        Provider provider,
        Identity sender,
        sequence<string> remove_user_ids,
        sequence<KeyPackage> add_members,
        boolean force_self_update
    );

    [Throws=MlsError]
    CommitBundle commit_member_add_with_removals(
        Provider provider,
        Identity sender,
        sequence<string> remove_user_ids,
        sequence<KeyPackage> add_members
    );

    [Throws=MlsError]
    CommitBundle commit_self_update_with_removals(
        Provider provider,
        Identity sender,
        sequence<string> remove_user_ids
    );

    [Throws=MlsError]
    CommitBundle commit_member_removals(
        Provider provider,
        Identity sender,
        sequence<string> remove_user_ids
    );

    [Throws=MlsError]
    sequence<ProposalMessage> propose_remove_user(Provider provider, Identity sender, string user_id);

    [Throws=MlsError]
    CommitBundle self_update(Provider provider, Identity sender);
};

dictionary RecoveryKeys {
    bytes private_key;
    bytes public_key;
    string key_id;
    u16 ciphersuite;
};
dictionary RecoveryVaultMetadata {
    bytes public_key;
    string key_id;
    u16 ciphersuite;
};
dictionary RecoveryArchiveBlob {
    bytes ciphertext;
    bytes nonce;
    bytes aead_aad;
    bytes adk;
};
dictionary RecoveryArchiveWrap {
    bytes kem_output;
    bytes ciphertext;
    u16 ciphersuite;
    bytes hpke_info;
};

dictionary RecoveryJournalEntry {
    string key;
    string kind;
    string cid;
    u64 group_generation;
    u64 epoch;
    string scope;
    bytes payload;
    string status;
    u32 retry_count;
    i64 created_at;
    i64 next_retry_at;
    string? last_error;
};
interface RecoveryJournal {
    [Throws=MlsError]
    constructor(string path);
    [Throws=MlsError]
    boolean insert_if_absent(RecoveryJournalEntry entry);
    [Throws=MlsError]
    void put(RecoveryJournalEntry entry);
    [Throws=MlsError]
    RecoveryJournalEntry? get(string key);
    [Throws=MlsError]
    sequence<RecoveryJournalEntry> page(string kind, string status, i64 now, string? cid, string? after_key, u32 limit);
    [Throws=MlsError]
    void remove(string key);
    [Throws=MlsError]
    void commit_upload(string pending_key, RecoveryJournalEntry ack, RecoveryJournalEntry? checkpoint);
};
